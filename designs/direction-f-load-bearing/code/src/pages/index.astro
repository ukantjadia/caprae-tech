<!-- The island is gated at the framework level. A reader who asked for reduced
     motion never fetches three, R3F or drei at all. Branching inside the
     component would be too late: the bundle would already be downloaded. -->
<Stage client:media="(prefers-reduced-motion: no-preference)">
  <svg class="plate-svg" viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="xMidYMid meet" role="img"
       aria-label={`Simply supported truss at rated load, ${SPAN} bays, midspan deflection ${ratedMm} millimetres over a ${SPAN_METRES} metre span.`}>
    {members.map((m) => (
      <line x1={m.x1.toFixed(1)} y1={m.y1.toFixed(1)} x2={m.x2.toFixed(1)} y2={m.y2.toFixed(1)}
            stroke="#EDEDEA" stroke-width={m.w} stroke-opacity="0.86" />
    ))}
    <polyline points={railPts} fill="none" stroke="#E0A95C" stroke-width="1.6" />
  </svg>
  <p class="plate-rd">
    <span>100</span>
    <span class="rd">load 100% of rated</span>
    <span class="rd">midspan {ratedMm} mm · span {SPAN_METRES} m · {SPAN} bays</span>
    <span class="rd">deflection drawn &times;{EXAG}</span>
