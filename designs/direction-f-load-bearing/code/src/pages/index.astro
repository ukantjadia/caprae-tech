---
/* Direction F — LOAD BEARING
 * Contract: design-isperiation-prompts/adapted-prompts/02-ascent-to-caprae.md
 *
 * The stage is the FIRST element on the page. There is no hero block above the
 * scrub, so the primary action lives in the fixed nav, visible at every scroll
 * depth and every breakpoint.
 */
import Stage from '../components/Stage.jsx';
import { deflection, L, SPAN, RATED_RATIO, SPAN_METRES, midspanMm, EXAG } from '../lib/beam.js';
import '../styles/load.css';

/* The static plate is drawn HERE, at build time, from the same closed form the
 * live scene uses. Same maths, different renderer. A reduced-motion or no-JS
 * reader gets a real drawing of the structure at rated load, not a screenshot
 * of the canvas. */
const VB_W = 1200, VB_H = 300;
const PAD = 60;
const DEPTH_PX = 46;
const AMP = (VB_W - PAD * 2) / RATED_RATIO * EXAG;  // same stated exaggeration as the scene

function nodeY(i) {
  const x = (i / SPAN) * L;
  return VB_H / 2 + (deflection(x, 1) / (L / RATED_RATIO)) * AMP;
}
function nodeX(i) {
  return PAD + (i / SPAN) * (VB_W - PAD * 2);
}

const members = [];
for (let b = 0; b < SPAN; b++) {
  const x0 = nodeX(b), x1 = nodeX(b + 1);
  const y0 = nodeY(b), y1 = nodeY(b + 1);
  members.push({ x1: x0, y1: y0 - DEPTH_PX / 2, x2: x1, y2: y1 - DEPTH_PX / 2, w: 1.6 });
  members.push({ x1: x0, y1: y0 + DEPTH_PX / 2, x2: x1, y2: y1 + DEPTH_PX / 2, w: 1.6 });
  members.push({ x1: x0, y1: y0 - DEPTH_PX / 2, x2: x0, y2: y0 + DEPTH_PX / 2, w: 1.0 });
  members.push({ x1: x0, y1: y0 + DEPTH_PX / 2, x2: x1, y2: y1 - DEPTH_PX / 2, w: 0.8 });
}
const railPts = Array.from({ length: SPAN + 1 }, (_, i) =>
  `${nodeX(i).toFixed(1)},${(nodeY(i) + DEPTH_PX / 2 + 9).toFixed(1)}`).join(' ');

const ratedMm = midspanMm(1).toFixed(1);
