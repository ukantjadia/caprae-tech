---
import '../styles/global.css';
const { title, variant, description } = Astro.props;
---
<!doctype html>
<html lang="en" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="./">CAPRAE TECH</a>
      <nav aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#method">Method</a>
        <a class="nav-cta" href="mailto:partners@capraecapital.com">Start a conversation</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <p>Caprae Tech <span>Part of Caprae Capital</span></p>
      <a href="mailto:partners@capraecapital.com">partners@capraecapital.com</a>
    </footer>
    <script>
      const local = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      const force = local && new URLSearchParams(location.search).get('motion') === 'on';
      if (force) document.documentElement.dataset.motion = 'on';
    </script>
  </body>
</html>
