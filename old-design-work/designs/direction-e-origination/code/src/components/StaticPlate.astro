---
/* The reduced-motion and no-JS tier. Not a screenshot of the canvas: a drawing
 * of the field at a chosen moment, computed at BUILD time from the same model
 * the live scene uses. Same maths, different renderer.
 */
import { buildField, positionAt } from '../lib/field.js';
const T = 18.4;
const { bodies, survivors } = buildField(2600, 0x9E3779B9);
const tmp = { x: 0, y: 0, z: 0, s: 0, u: 0 };
const pitch = 0.58, cp = Math.cos(pitch), sp = Math.sin(pitch);
const marks = [];
for (const b of bodies) {
  positionAt(b, T, tmp);
  const wy = cp * tmp.y - sp * tmp.z;
  const wz = sp * tmp.y + cp * tmp.z;
  const d = 5.0 - wz;
  if (d < 0.4) continue;
  const f = 1 / Math.tan((38 * Math.PI) / 360);
  const x = (f * tmp.x) / d, y = (f * (wy - 0.30)) / d;
  if (Math.abs(x) > 1.3 || Math.abs(y) > 1.1) continue;
  let a = b.close ? 1 : 0.16 + 0.5 * ((b.seed * 13.7) % 1);
  if (!b.close && tmp.s >= b.drop) {
    const g = Math.min(1, Math.max(0, (tmp.s - b.drop) / 0.16));
    a *= 1 - g * g * (3 - 2 * g);
  }
  if (a < 0.05) continue;
  const near = 0.62 + 0.38 * Math.min(1, Math.max(0, (wz + 1.6) / 3.2));
  marks.push({
    x: (500 + x * 480).toFixed(1),
    y: (300 - y * 260).toFixed(1),
    r: (b.close ? 7 : 0.8 + (((b.seed * 7.1) % 1) > 0.985 ? 1.4 : 0)).toFixed(2),
    o: (a * near).toFixed(3),
    c: b.close ? '#FFFFFF' : '#E8E6E1',
  });
}
---
<svg class="plate" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {marks.map((m) => <circle cx={m.x} cy={m.y} r={m.r} fill={m.c} opacity={m.o} />)}
</svg>
