---
import Shell from '../components/Shell.astro';
import Scene from '../components/Scene.astro';
import Proof from '../components/Proof.astro';
---
<Shell title="Registered Depth — Caprae Tech" variant="registered" description="A registered field of engineering evidence.">
  <section class="hero registered-hero">
    <div class="reg-left"><h1>Engineers already inside the operating room.</h1></div>
    <div class="reg-right">
      <p>Caprae's team builds with searchers, bankers and operators—not outside their context.</p>
      <a class="primary" href="mailto:partners@capraecapital.com">Start a conversation</a>
      <p class="fold-proof"><strong>300,000+</strong> calls across five countries <span>Cold Call Killers · public record</span></p>
    </div>
    <Scene kind="registered" label="A field of plates resolving against the page's registration spine." />
    <div class="spine-label" aria-hidden="true">REGISTER / 34.0</div>
  </section>
  <section class="reg-declaration"><h2>Irregular inputs.<br />One accountable line.</h2><p>Every product, decision and source returns to the same governing axis. Nothing floats without an owner.</p></section>
  <Proof />
</Shell>
